{"nodes": [{"id": "architecture_policy_architecture_rules", "label": "Architecture Rules - eshop-architecture-policy v1.0.0", "file_type": "document", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Generated from rules/patterns/validators/exceptions YAML; single source of truth for architecture governance used by pre-commit, review agent, test agent and CI.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_architecture_validate", "label": "architecture.validate(checkpoint, context, artifacts)", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_decision_model", "label": "Decision model (BLOCK > WARN > PASS)", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Validator errors fail closed; semantic validators never call an LLM and return needs_review capped at WARN.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_exceptions_register", "label": "Exceptions register", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Exceptions scoped to one rule and path globs, max 90 days, approver role by severity.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_val_semantic_review", "label": "VAL-SEMANTIC-REVIEW validator", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_profile_yaml", "label": "profiles/dotnet/profile.yaml", "file_type": "document", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_recommendations_md", "label": "docs/architecture/recommendations.md", "file_type": "document", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_arch_001", "label": "ARCH-001 Layer dependencies point inward", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Keeps Ordering business invariants testable and independent of EF Core, RabbitMQ and ASP.NET Core.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_arch_002", "label": "ARCH-002 No cross-service project references", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Compile-time coupling defeats independent deployability and leaks domain models.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_arch_003", "label": "ARCH-003 Service hosts use eShop.ServiceDefaults", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "ServiceDefaults centralizes OpenTelemetry, health checks, discovery and resilience.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_arch_004", "label": "ARCH-004 Cross-context collaboration is event-driven", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Ordering saga relies on async events; synchronous coupling causes cascading failures.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_arch_005", "label": "ARCH-005 Capabilities in right bounded context", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Misplaced capabilities create shared ownership of data and invariants; requires human judgment.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_arch_006", "label": "ARCH-006 Central package management", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Consistent versions and one-line security patching.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_arch_007", "label": "ARCH-007 Integration events are immutable records", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "RabbitMQEventBus routes by CLR type name so the name is the wire contract.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_api_001", "label": "API-001 HTTP endpoints are versioned", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Consumers deploy independently.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_api_002", "label": "API-002 State-changing endpoints require authorization", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Catalog write endpoints were anonymous, allowing anyone to change prices.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_api_003", "label": "API-003 Backward-compatible API contracts", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Breaking changes break independently deployed consumers at runtime.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_api_004", "label": "API-004 Non-idempotent operations made idempotent", "file_type": "concept", "source_file": "architecture-policy/architecture-rules.md", "source_location": null, "rationale": "Retries would create duplicate orders and charges.", "_origin": "semantic"}, {"id": "architecture_policy_architecture_rules_sec_0