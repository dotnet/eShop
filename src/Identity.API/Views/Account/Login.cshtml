@model LoginViewModel

<div class="login-page">
    @if (Model.EnableLocalLogin)
    {
        <aside class="login-visual" aria-hidden="true">
            <div class="login-visual-inner">
                <p class="login-visual-kicker">AdventureWorks</p>
                <p class="login-visual-line">Gear up for what's next.</p>
            </div>
        </aside>

        <section class="login-card" aria-labelledby="login-title">
            <div class="login-card-header">
                <h1 id="login-title">Login</h1>
            </div>

            <form asp-route="Login" class="login-form">
                <input type="hidden" asp-for="ReturnUrl" />
                <partial name="_ValidationSummary" />

                <div class="form-group">
                    <label asp-for="Username"></label>
                    <input class="form-control" placeholder="Username" asp-for="Username" autofocus>
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input type="password" class="form-control" placeholder="Password" asp-for="Password" autocomplete="off">
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                @if (Model.AllowRememberLogin)
                {
                    <div class="form-group form-group-check">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="RememberLogin">
                            <label class="form-check-label" asp-for="RememberLogin">
                                Remember me
                            </label>
                        </div>
                    </div>
                }

                <p class="login-hint">The default users are alice/bob, password: Pass123$</p>

                <button class="btn btn-primary login-submit" name="button" value="login">Login</button>
            </form>
        </section>
    }
</div>