@model LoginViewModel

<div class="login-page">
    <div class="container">
        <div class="row top-buffer">

            @if (Model.EnableLocalLogin)
            {
                <div class="col"></div>
                <div class="col-sm-6">
                    <form asp-route="Login">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div class="login-container">
                            <h2>Iniciar Sesión</h2>
                            <partial name="_ValidationSummary" />
                            <div class="form-group">
                                <label asp-for="Username"></label>
                                <input class="form-control" placeholder="Usuario" asp-for="Username" autofocus>
                            </div> 
                            <div class="form-group">
                                <label asp-for="Password"></label>
                                <input type="password" class="form-control" placeholder="Contraseña" asp-for="Password" autocomplete="off">
                            </div>
                            @if (Model.AllowRememberLogin)
                            {
                                <div class="form-group">
                                    <div class="form-check">
                                        <input class="form-check-input" asp-for="RememberLogin">
                                        <label class="form-check-label" asp-for="RememberLogin">
                                            Recordarme
                                        </label>
                                    </div>
                                </div>
                            }

                            <div>
                                <p>Los usuarios predeterminados son alice/bob, contraseña: Pass123$</p>
                            </div>
                            <button class="btn btn-primary" name="button" value="login" style>Iniciar Sesión</button>
                        </div>
                    </form>
                </div>
                <div class="col"></div>
            }
        </div>
    </div>
</div>