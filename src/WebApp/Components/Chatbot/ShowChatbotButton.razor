@using eShop.WebApp.Components.Chatbot

<button type="button" class="show-chatbot" data-chat-toggle data-chat-eyes aria-controls="chatbot-pane" aria-expanded="false" title="Ask the assistant" aria-label="Ask the assistant">
    <span class="chatbot-eyes" aria-hidden="true">
        <span class="chatbot-eye">
            <svg class="chatbot-pupil" viewBox="0 0 20 32" xmlns="http://www.w3.org/2000/svg">
                <path d="M13 5 Q 3 16 13 27" />
            </svg>
        </span>
        <span class="chatbot-eye">
            <svg class="chatbot-pupil" viewBox="0 0 20 32" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 5 Q 17 16 7 27" />
            </svg>
        </span>
    </span>
</button>

<div class="chatbot-dock" data-chat-dock>
    <Chatbot />
</div>
