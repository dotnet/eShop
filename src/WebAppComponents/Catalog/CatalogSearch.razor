@inject CatalogService CatalogService
@inject NavigationManager Nav

@if (catalogBrands is not null && catalogItemTypes is not null)
{
    <aside class="catalog-search" aria-label="Catalog filters" data-enhance-nav="true">
        <div class="catalog-search-toolbar">
            <details class="catalog-search-details">
                <summary class="catalog-search-summary">
                    <span class="catalog-search-title">
                        <img role="presentation" src="icons/filters.svg" />
                        Filter products
                    </span>
                    @if (HasActiveFilter)
                    {
                        <span class="catalog-search-count" aria-label="@ActiveFilterCount active filters">@ActiveFilterCount</span>
                    }
                </summary>

                <div class="catalog-search-body">
                    <div class="catalog-search-heading">
                        <div>
                            <span>Refine results</span>
                            <h2>Find the right gear</h2>
                        </div>
                        @if (HasActiveFilter)
                        {
                            <a class="catalog-search-reset" href="@ResetUri()">Clear all</a>
                        }
                    </div>

                    <div class="catalog-search-groups">
                        <div class="catalog-search-group">
                            <h3>Brand</h3>
                            <div class="catalog-search-group-tags">
                                <a href="@BrandUri(null)"
                                   class="catalog-search-tag @(BrandId == null ? "active" : "")">
                                    All brands
                                </a>
                                @foreach (var brand in catalogBrands)
                                {
                                    <a href="@BrandUri(brand.Id)"
                                       class="catalog-search-tag @(BrandId == brand.Id ? "active" : "")">
                                        @brand.Brand
                                    </a>
                                }
                            </div>
                        </div>
                        <div class="catalog-search-group">
                            <h3>Category</h3>
                            <div class="catalog-search-group-tags">
                                <a href="@TypeUri(null)"
                                   class="catalog-search-tag @(ItemTypeId == null ? "active" : "")">
                                    All categories
                                </a>
                                @foreach (var itemType in catalogItemTypes)
                                {
                                    <a href="@TypeUri(itemType.Id)"
                                       class="catalog-search-tag @(ItemTypeId == itemType.Id ? "active" : "")">
                                        @itemType.Type
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </details>

            @if (HasActiveFilter)
            {
                <div class="catalog-search-active" aria-label="Applied filters">
                    @if (ActiveBrandName is not null)
                    {
                        <a class="catalog-active-chip" href="@BrandUri(null)" aria-label="Remove brand filter @ActiveBrandName">
                            <span>@ActiveBrandName</span>
                            <span class="catalog-active-chip-x" aria-hidden="true">&times;</span>
                        </a>
                    }
                    @if (ActiveTypeName is not null)
                    {
                        <a class="catalog-active-chip" href="@TypeUri(null)" aria-label="Remove category filter @ActiveTypeName">
                            <span>@ActiveTypeName</span>
                            <span class="catalog-active-chip-x" aria-hidden="true">&times;</span>
                        </a>
                    }
                </div>
            }
        </div>
    </aside>
}

@code {
    IEnumerable<CatalogBrand>? catalogBrands;
    IEnumerable<CatalogItemType>? catalogItemTypes;
    [Parameter] public int? BrandId { get; set; }
    [Parameter] public int? ItemTypeId { get; set; }

    bool HasActiveFilter => BrandId is not null || ItemTypeId is not null;
    int ActiveFilterCount => (BrandId is null ? 0 : 1) + (ItemTypeId is null ? 0 : 1);

    string? ActiveBrandName => catalogBrands?.FirstOrDefault(b => b.Id == BrandId)?.Brand;
    string? ActiveTypeName => catalogItemTypes?.FirstOrDefault(t => t.Id == ItemTypeId)?.Type;

    protected override async Task OnInitializedAsync()
    {
        var brandsTask = CatalogService.GetBrands();
        var itemTypesTask = CatalogService.GetTypes();
        await Task.WhenAll(brandsTask, itemTypesTask);
        catalogBrands = brandsTask.Result;
        catalogItemTypes = itemTypesTask.Result;
    }

    private string BrandUri(int? brandId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "brand", brandId },
    });

    private string TypeUri(int? typeId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "type", typeId },
    });

    private string ResetUri() => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "brand", null },
        { "type", null },
    });
}
