#!/usr/bin/env bash
# AI pipeline gate: every stage's pre-push check (QE: stories, plans and story tests being pushed have
# verifier-approved, current plans and tests). No LLM calls; bypass the QE check once with QE_SKIP=1 git push.
command -v node >/dev/null 2>&1 || exit 0
exec node "$(git rev-parse --show-toplevel)/scripts/pipeline/pipeline.mjs" git-hook pre-push
