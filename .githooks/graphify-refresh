#!/usr/bin/env bash
# Rebuild the local graphify graph in the background (code + shared semantic
# cache, no LLM calls). Nothing is staged or committed. Never blocks git.
root="$(git rev-parse --show-toplevel)" || exit 0
command -v graphify >/dev/null 2>&1 || exit 0
( "$root/scripts/graphify-build.sh" >/dev/null 2>&1 & ) >/dev/null 2>&1
exit 0
