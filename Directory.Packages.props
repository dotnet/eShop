<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Version together with Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Foundry" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Yarp" Version="17.0.0" />
    <PackageVersion Include="Aspire.Npgsql" Version="17.0.0" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="17.0.0" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="17.0.0" />
    <PackageVersion Include="Aspire.Azure.AI.Extensions.OpenAI" Version="17.0.0-preview.1.26567.5" />
    <!-- Version together with Asp.Versioning -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Http.Client" Version="10.2.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <!-- Version together with ASP.NET -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="11.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
    <PackageVersion Include="MSTest" Version="4.5.3" />
    <!-- Version together with EF -->
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 11.0.0-rc.3 pins EF Core to 11.0.0-rc.3 exactly; move all of these to 11.0.0 once Npgsql 11.0.0 ships. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <!-- Version together with runtime -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <!-- dotnet/extensions packages -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="11.0.0" />
    <!-- Xabaril packages -->
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
    <!-- AI -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.6.1" />
    <PackageVersion Include="CommunityToolkit.Aspire.OllamaSharp" Version="13.6.1" />
    <!-- Open Telemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!-- IdentityServer -->
    <PackageVersion Include="Duende.IdentityServer" Version="8.0.11" />
    <PackageVersion Include="Duende.IdentityServer.AspNetIdentity" Version="8.0.11" />
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="8.0.11" />
    <PackageVersion Include="Duende.IdentityServer.EntityFramework.Storage" Version="8.0.11" />
    <PackageVersion Include="Duende.IdentityServer.Storage" Version="8.0.11" />
    <!-- Scaffolding -->
    <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.3" />
    <!-- Grpc -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <!-- Miscellaneous -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="IdentityModel" Version="7.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <!-- Before license change -->
    <PackageVersion Include="MediatR" Version="13.1.0" />
  </ItemGroup>
</Project>
