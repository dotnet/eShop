{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "name": "qe-session-context",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/scripts/hooks/gemini-adapter.mjs\" SessionStart -- node scripts/pipeline/pipeline.mjs hook session-start",
            "timeout": 30000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "qe-architecture-review",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/scripts/hooks/gemini-adapter.mjs\" Stop -- node scripts/pipeline/pipeline.mjs hook stop",
            "timeout": 1800000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "search_file_content|grep_search|glob|run_shell_command",
        "hooks": [
          {
            "name": "graphify-guard-search",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/scripts/hooks/gemini-adapter.mjs\" PreToolUse -- graphify hook-guard search --strict",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "read_file|read_many_files|list_directory",
        "hooks": [
          {
            "name": "graphify-guard-read",
            "type": "command",
            "command": "node \"$GEMINI_PROJECT_DIR/scripts/hooks/gemini-adapter.mjs\" PreToolUse -- graphify hook-guard read --strict",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
