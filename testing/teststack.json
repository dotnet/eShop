{
  // Settings for the scenario-driven Docker Compose test stack (see testing/README.md).
  // Host ports must match src/eShop.AppHost/TestStack.cs.
  "compose": {
    "project": "eshop-teststack",
    "file": "deploy/teststack/docker-compose.yaml",
    "envFile": "artifacts/teststack/.env.teststack"
  },
  "scenariosDirectory": "testing/scenarios",
  "baseScenario": "_base",
  "postgres": {
    "port": 18432,
    "username": "postgres",
    "passwordVariable": "POSTGRES_PASSWORD",
    "databases": [ "catalogdb", "identitydb", "orderingdb", "webhooksdb" ]
  },
  "redis": {
    "port": 18379,
    "passwordVariable": "REDIS_PASSWORD"
  },
  "rabbitMq": {
    "port": 18672,
    "username": "guest",
    "passwordVariable": "EVENTBUS_PASSWORD",
    "queues": [ "Basket", "Catalog", "Ordering", "Ordering.webapp", "OrderProcessor", "PaymentProcessor", "Webhooks" ]
  },
  "hiLoSequences": [
    { "database": "orderingdb", "sequence": "ordering.buyerseq", "table": "ordering.buyers", "column": "Id", "service": "ordering-api" },
    { "database": "orderingdb", "sequence": "ordering.paymentseq", "table": "ordering.paymentmethods", "column": "Id", "service": "ordering-api" },
    { "database": "orderingdb", "sequence": "ordering.orderseq", "table": "ordering.orders", "column": "Id", "service": "ordering-api" },
    { "database": "orderingdb", "sequence": "ordering.orderitemseq", "table": "ordering.orderItems", "column": "Id", "service": "ordering-api" }
  ],
  "infrastructureServices": [ "postgres", "redis", "eventbus", "teststack-dashboard" ],
  "services": [
    { "name": "identity-api", "url": "http://localhost:18081/.well-known/openid-configuration", "databases": [ "identitydb" ] },
    { "name": "catalog-api", "url": "http://localhost:18082/api/catalog/items?api-version=1.0&pageSize=1", "databases": [ "catalogdb" ], "queues": [ "Catalog" ] },
    { "name": "basket-api", "url": "http://localhost:18083/", "http2": true, "queues": [ "Basket" ] },
    { "name": "ordering-api", "url": "http://localhost:18084/", "databases": [ "orderingdb" ], "queues": [ "Ordering" ] },
    { "name": "webhooks-api", "url": "http://localhost:18085/", "databases": [ "webhooksdb" ], "queues": [ "Webhooks" ] },
    { "name": "order-processor", "queues": [ "OrderProcessor" ] },
    { "name": "payment-processor", "queues": [ "PaymentProcessor" ] },
    { "name": "mobile-bff", "url": "http://localhost:18087/" },
    { "name": "webhooksclient", "url": "http://localhost:18086/" },
    { "name": "webapp", "url": "http://localhost:18080/", "queues": [ "Ordering.webapp" ] }
  ]
}
